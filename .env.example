# Example Frontend Environment Variables
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_AUTH_URL="http://localhost:5000"

# Production values (set these in Vercel environment variables)
# NEXT_PUBLIC_API_URL="https://gramgains-backend.onrender.com/api"
# NEXT_PUBLIC_AUTH_URL="https://gramgains-backend.onrender.com"

# Dev Skip - set to true to enable frontend-only mock mode (no backend required)
NEXT_PUBLIC_DEV_SKIP=false
